<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'About Us - FushidaLanka' %></title>
  <meta name="description" content="Learn about FushidaLanka, a trusted Sri Lankan hardware supplier since 2010.">
  <link rel="stylesheet" href="/css/subpages-redesign.css">
