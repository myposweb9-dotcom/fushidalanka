<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - FushidaLanka</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=2">
  <style>
    /* Minimal local overrides to ensure centering if global CSS isn't applied */
    body.admin-login-page{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh;margin:0;font-family:'Segoe UI',Tahoma, Geneva, Verdana, sans-serif}
    .admin-login-wrapper{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box}
    .admin-login-container{max-width:480px;width:100%;background:rgba(255,255,255,0.98);border-radius:14px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.12);border:1px solid rgba(255,255,255,0.2)}
    .admin-login-header{background:linear-gradient(135deg,#1e3c72 0%,#2a5298 100%);color:#fff;padding:2rem 2rem 1.5rem;text-align:center}
    .admin-login-body{padding:2rem}
    @media(max-width:576px){.admin-login-wrapper{align-items:flex-start;padding-top:36px;padding-bottom:36px}.admin-login-container{width:calc(100% - 32px);border-radius:12px}}
  </style>
</head>
<body class="admin-login-page">
  <div class="admin-login-wrapper">
    <div class="admin-login-container">
      <div class="admin-login-header">
        <i class="fas fa-shield-alt" style="font-size:40px;color:rgba(255,255,255,0.95);margin-bottom:12px;"></i>
        <h2 style="margin:0;font-weight:600">Admin Portal</h2>
        <p style="margin:8px 0 0;opacity:0.9;font-size:0.95rem;">Secure access to FushidaLanka management system</p>
      </div>

      <div class="admin-login-body">
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
          <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <%= error %>
          </div>
        <% } %>
        <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
          <div class="alert alert-success" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= success_msg %>
          </div>
        <% } %>

        <form action="/admin/login" method="POST">
          <div class="mb-3 form-floating">
            <input type="email" class="form-control" id="email" name="email" placeholder="admin@fushidalanka.com" required>
            <label for="email"><i class="fas fa-envelope me-2"></i>Email Address</label>
          </div>

          <div class="mb-3 form-floating">
            <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
            <label for="password"><i class="fas fa-lock me-2"></i>Password</label>
          </div>

          <button type="submit" class="btn btn-primary btn-admin-login w-100" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);border:none;border-radius:8px;padding:.75rem;font-weight:600;">
            <i class="fas fa-sign-in-alt me-2"></i>Access Admin Panel
          </button>
        </form>

        <div class="text-center mt-3" style="padding-top:1rem;border-top:1px solid #eee">
          <a href="/" style="color:#667eea;text-decoration:none;font-weight:500"><i class="fas fa-arrow-left me-1"></i>Back to Website</a>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js?v=2"></script>
  <script>
    // Autofocus and a small safety to avoid errors if element missing
    (function(){
      var e = document.getElementById('email'); if(e) e.focus();
      var form = document.querySelector('form'); if(form){
        form.addEventListener('submit', function(){
          try{ document.querySelector('.btn-admin-login').disabled = true; }catch(e){}
        });
      }
    })();
  </script>
</body>
</html>
