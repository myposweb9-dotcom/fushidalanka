<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Bulk Order & Trade Supply — FushidaLanka</title><meta name="description" content="Request a bulk hardware quote from FushidaLanka."><link rel="stylesheet" href="/css/home-redesign.css"><link rel="stylesheet" href="/css/subpages-redesign.css"></head><body class="home-redesign sp-page"><%- include('partials/modern-header') %><main><section class="sp-hero"><div class="modern-inner sp-hero-inner"><p class="sp-eyebrow">Contractors · builders · project managers</p><h1>Need hardware<br><span>in bulk?</span></h1><p>Tell us what you’re building. We’ll help plan the right product mix, quantities and delivery for your next project.</p></div></section><section class="sp-section"><div class="modern-inner sp-grid-2"><div><p class="sp-eyebrow">Trade supply</p><h2>Plan your next <span>project.</span></h2><p class="sp-lead">From one site to a full procurement plan, our team can help with product selection, availability, pricing and delivery across Sri Lanka.</p><div class="sp-contact-item"><strong>Professional support</strong><span>Practical recommendations from people who understand the work.</span></div><div class="sp-contact-item"><strong>Competitive bulk pricing</strong><span>Custom quotes for contractors, businesses and project teams.</span></div><div class="sp-contact-item"><strong>Delivery coordination</strong><span>Plan quantities and delivery timing around your deadlines.</span></div><p style="margin-top:26px"><a class="sp-button" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">Chat on WhatsApp →</a></p></div><div class="sp-card"><form class="sp-form" id="bulkForm"><label for="name">Your name *</label><input id="name" name="name" required placeholder="Your name"><label for="company">Company</label><input id="company" name="company" placeholder="Company"><label for="phone">Phone *</label><input id="phone" name="phone" required placeholder="Phone"><label for="email">Email *</label><input id="email" name="email" type="email" required placeholder="Email"><label for="products">Products required</label><input id="products" name="products" placeholder="Products required"><label for="message">Quantities or deadlines</label><textarea id="message" name="message" placeholder="Tell us about quantities or deadlines"></textarea><button class="sp-button primary" type="submit">Send enquiry →</button><p id="bulkStatus" style="margin:0;color:var(--sp-brass-dark);font-size:13px"></p></form></div></div></section></main><%- include('partials/modern-footer') %><a class="sp-whatsapp" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">◔ WhatsApp</a><script>document.getElementById('bulkForm').addEventListener('submit',async function(e){e.preventDefault();const s=document.getElementById('bulkStatus');s.textContent='Sending enquiry…';try{const r=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:this.name.value,email:this.email.value,subject:'Bulk order enquiry - '+(this.company.value||'Trade customer'),message:[this.products.value,this.message.value,'Company: '+this.company.value,'Phone: '+this.phone.value].filter(Boolean).join('\n')})});const j=await r.json();if(!r.ok)throw Error();s.textContent=j.message||'Thank you — our team will get back to you soon.';this.reset()}catch(_){s.textContent='Please call +94 75 750 5820 or message us on WhatsApp.'}});</script></body></html>
