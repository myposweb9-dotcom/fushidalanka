<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Contact Us - FushidaLanka' %></title>
  <meta name="description" content="Contact FushidaLanka for hardware recommendations, project supply plans and quotes.">
  <link rel="stylesheet" href="/css/home-redesign.css">
  <link rel="stylesheet" href="/css/subpages-redesign.css">
</head>
<body class="home-redesign sp-page">
  <%- include('partials/modern-header') %>
  <main>
    <section class="sp-hero"><div class="modern-inner sp-hero-inner"><p class="sp-eyebrow">Visit, call or write</p><h1>Let’s get<br><span>to work.</span></h1><p>Need a product recommendation, quote or project supply plan? Our team is ready to help.</p><div class="sp-actions" style="margin-top:26px"><a class="sp-button primary" href="tel:+94757505820">Call +94 75 750 5820</a><a class="sp-button light" href="mailto:aman@fushidalanka.com">Email us</a></div></div></section>
    <section class="sp-section"><div class="modern-inner sp-grid-2"><div><p class="sp-eyebrow">Start a conversation</p><h2>Tell us what you’re <span>building.</span></h2><p class="sp-lead">Send your requirements and our team will get back to you with practical recommendations and a clear quote.</p><div class="sp-contact-item"><strong>No.24 1/2, Messenger Street</strong><span>Colombo 12, Sri Lanka</span></div><div class="sp-contact-item"><strong><a href="tel:+94757505820">+94 75 750 5820</a></strong><span>Mon–Fri 8:30–5:30 · Sat 8:30–1</span></div><div class="sp-contact-item"><strong><a href="mailto:aman@fushidalanka.com">aman@fushidalanka.com</a></strong><span>Questions welcome</span></div></div><div class="sp-card"><form class="sp-form" id="contactForm"><div><label for="name">Full name *</label><input id="name" name="name" required></div><div><label for="email">Email address *</label><input id="email" name="email" type="email" required></div><div><label for="subject">Subject *</label><input id="subject" name="subject" required></div><div><label for="message">Message *</label><textarea id="message" name="message" required></textarea></div><button class="sp-button primary" type="submit">Send message →</button><p id="contactStatus" style="margin:0;color:var(--sp-brass-dark);font-size:13px"></p></form></div></div></section>
    <section class="sp-section alt"><div class="modern-inner"><p class="sp-eyebrow">Find us</p><h2>Visit our <span>office.</span></h2><iframe class="sp-map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.902957!2d79.852952!3d6.927079!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae25963120b1509%3A0x402b54549da7ec9!2s9%20Abdul%20Caffoor%20Mawatha%2C%20Colombo%2000300!5e0!3m2!1sen!2slk" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe></div></section>
  </main>
  <%- include('partials/modern-footer') %>
  <a class="sp-whatsapp" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">◔ WhatsApp</a>
  <script>
  document.getElementById('contactForm').addEventListener('submit',async function(event){event.preventDefault();const status=document.getElementById('contactStatus');status.textContent='Sending message…';try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(event.target)))});const result=await response.json();if(!response.ok)throw new Error(result.error||'Unable to send');status.textContent=result.message||'Thank you — we will get back to you soon.';event.target.reset()}catch(error){status.textContent='Please call +94 75 750 5820 or message us on WhatsApp.'}}
  );
  </script>
</body>
</html>
