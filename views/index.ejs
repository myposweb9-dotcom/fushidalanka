<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Build Better</title>
  <meta name="description" content="FushidaLanka Hardware — premium tools, building materials and hardware solutions in Sri Lanka. Quality products, expert service and islandwide delivery.">
  <meta name="keywords" content="FushidaLanka hardware, tools, building materials, Colombo hardware, electrical supplies, safety gear">
  <meta property="og:title" content="FushidaLanka Hardware — Build Better">
  <meta property="og:description" content="Premium tools, materials and expert support for every build.">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/home-redesign.css">
</head>
<body class="home-redesign">
  <div class="utility"><div class="utility-inner"><span>Colombo 12 · Islandwide service</span><span>Professional supply · Expert support · Since 2010</span><a href="https://wa.me/94757505820" target="_blank" rel="noreferrer">WhatsApp us ↗</a></div></div>

  <nav class="site-nav" id="siteNav">
    <div class="nav-inner">
      <a href="/" class="brand"><img class="brand-logo" src="/images/FushidaLankaLogo.png" alt="FushidaLanka Hardware"></a>
    <div class="nav-links"><a href="/">Home</a><a href="/products">Products</a><a href="/categories">Categories</a><a href="/about">About us</a><a href="/bulk-order">Trade supply</a><a href="/contact">Contact</a></div>
      <div class="nav-actions"><a href="/products">Explore products ↗</a><button class="nav-menu" id="menuToggle" aria-label="Toggle navigation">☰</button></div>
    </div>
    <div class="mobile-nav" id="mobileNav"><a href="/">Home</a><a href="/products">Products</a><a href="/categories">Categories</a><a href="/about">About us</a><a href="/bulk-order">Trade supply</a><a href="/contact">Contact</a></div>
  </nav>

  <main id="top">
    <section class="hero">
      <div class="hero-content"><div class="hero-copy"><p class="eyebrow">Quality hardware & building solutions</p><h1>Everything you need to <span>build better.</span></h1><p>Premium tools, materials and expert support for the work that moves Sri Lanka forward. From a weekend fix to a major project, start with the right gear.</p><div class="hero-ctas"><a href="#products" class="btn btn-primary">Explore products ↓</a><a href="tel:+94757505820" class="btn btn-outline">Call +94 75 750 5820</a></div><div class="hero-proof"><div class="avatars"><span class="avatar">M</span><span class="avatar">R</span><span class="avatar">S</span></div><span><strong>10K+</strong> customers served with confidence</span></div></div></div>
      <div class="hero-stats"><div class="hero-stats-inner"><div class="stat"><strong>15+</strong><span>Years of service</span></div><div class="stat"><strong>500+</strong><span>Projects completed</span></div><div class="stat"><strong>24/7</strong><span>Support available</span></div><div class="stat"><strong>99%</strong><span>Satisfaction rate</span></div></div></div>
    </section>

    <section class="trust"><div class="trust-inner"><strong>Built for the people who <span>build.</span></strong><div class="trust-points"><span>Genuine products</span><span>Colombo delivery</span><span>Manufacturer warranty</span></div></div></section>

    <section class="section" id="categories"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">Start with the right section</p><h2>Shop by discipline.</h2></div><a class="mini-link" href="/products">View all products →</a></div><div class="category-grid">
      <% const fallbackCategories = [{name:'Tools & Equipment',slug:'tools'},{name:'Building Materials',slug:'materials'},{name:'Electrical',slug:'electrical'},{name:'Safety Gear',slug:'safety'}]; const categoryCards = (categories && categories.length >= 4 ? categories.slice(0, 4) : fallbackCategories); const categoryImages = ['https://images.unsplash.com/photo-1504148455328-c376907d081c?auto=format&fit=crop&w=900&q=85','https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=900&q=85','https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=900&q=85','https://images.unsplash.com/photo-1578496781985-452d4a934d50?auto=format&fit=crop&w=900&q=85']; %>
      <% categoryCards.forEach((category, index) => { %><a class="category-card" href="/products?category=<%= category.slug || category.id %>"><img src="<%= categoryImages[index % categoryImages.length] %>" alt="<%= category.name %>" loading="lazy"><div class="category-card-content"><small><%= ['Complete range','For every build','Safe & reliable','Work protected'][index] %></small><h3><%= category.name %></h3><span>Explore range →</span></div></a><% }) %>
    </div></div></section>

    <section class="section products" id="products"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">Curated for the job</p><h2>The essentials, <span>sorted.</span></h2></div><p style="max-width:420px;margin:0;color:var(--muted);font-size:13px;line-height:1.7">Search by product, code, category or specification. Need something specific? Our team can help you find it.</p></div><div class="product-toolbar"><label class="search-box">⌕<input id="productSearch" type="search" placeholder="Search product name, code, brand or specification"></label><div class="product-tabs" id="productTabs"><button class="active" data-filter="all">All products</button><% categoryCards.forEach(category => { %><button data-filter="<%= category.id || category.slug || category.name %>"><%= category.name %></button><% }) %></div></div><div class="products-grid" id="productGrid">
      <% if (featuredProducts && featuredProducts.length) { %><% featuredProducts.slice(0, 12).forEach((product, index) => { %><article class="product-card" data-category="<%= product.categoryId || (product.category && (product.category.id || product.category.slug)) || '' %>" data-search="<%= [product.name, product.code, product.brand, product.description, product.category && product.category.name].filter(Boolean).join(' ') %>"><div class="product-image"><% if (product.images && product.images.length) { %><img src="<%= product.images[0] %><%= product.updatedAt ? ((product.images[0].includes('?') ? '&' : '?') + 'v=' + new Date(product.updatedAt).getTime()) : '' %>" alt="<%= product.name %>" loading="lazy"><% } else { %><img src="/images/fushida-detail.webp" alt="<%= product.name %>" loading="lazy"><% } %><span class="product-badge"><%= product.status === 'active' ? 'Featured' : 'New' %></span><div class="product-actions"><button type="button" class="quick-enquiry" data-name="<%= product.name %>" data-code="<%= product.code || product.id %>">Ask on WhatsApp →</button></div></div><div class="product-meta"><span class="product-category"><%= product.category && product.category.name ? product.category.name : 'Hardware' %></span><h3><%= product.name %></h3><p><%= product.description ? product.description.substring(0, 90) : 'Premium quality product' %></p><div class="product-price"><span>LKR <%= product.price ? parseInt(product.price).toLocaleString('en-LK') : 'Contact' %></span><a href="/products/<%= product.id %>">View details ↗</a></div></div></article><% }) %><% } else { %><div style="grid-column:1/-1;padding:60px 20px;border:1px dashed var(--line);text-align:center;color:var(--muted)"><h3 style="font-size:26px;color:var(--ink)">The catalogue is being refreshed.</h3><p>Browse all products or speak with our team for help sourcing what you need.</p><a class="mini-link" href="/products">Browse the full catalogue →</a></div><% } %>
    </div></div></section>

    <section class="section dark-section" id="about"><div class="section-inner about-grid"><div class="about-image"><img src="/images/fushida-detail.webp" alt="Professional hardware tools" loading="lazy"><div class="about-caption"><small>The FushidaLanka standard</small><p>Good work starts with<br>good hardware.</p></div></div><div class="about-copy"><div class="section-heading"><div><p class="eyebrow">Why professionals return</p><h2>A better way to <span>source.</span></h2></div></div><p>FushidaLanka began as a small hardware shop in 2010. Today, we support residential, commercial and industrial customers with dependable products, practical advice and service that stays close to the work.</p><div class="benefits"><div class="benefit"><strong>Quality products</strong><p>Genuine, durable and backed by manufacturer warranties.</p></div><div class="benefit"><strong>Competitive pricing</strong><p>Fair prices with bulk buying options available.</p></div><div class="benefit"><strong>Fast delivery</strong><p>Same-day delivery available in the Colombo area.</p></div><div class="benefit"><strong>Easy returns</strong><p>A 30-day returns policy for peace of mind.</p></div></div><a class="mini-link" href="/about" style="margin-top:30px;color:#fff">Meet the team →</a></div></div></section>

    <section class="section bulk" id="bulk-order"><div class="section-inner bulk-grid"><div class="bulk-copy"><p class="eyebrow" style="color:rgba(23,25,23,.6)">Contractors · builders · project managers</p><h2>Need hardware<br>in bulk?</h2><p>Tell us what you’re building. We’ll help you plan the right product mix, quantities and delivery for your next project.</p><a href="https://wa.me/94757505820" target="_blank" rel="noreferrer" class="btn btn-outline" style="border-color:var(--ink);color:var(--ink)">Request a bulk quote →</a></div><form class="bulk-form" id="bulkForm"><h3>Start an enquiry</h3><input name="name" required placeholder="Your name"><input name="company" placeholder="Company"><input name="phone" required placeholder="Phone"><input name="email" type="email" required placeholder="Email"><input name="products" placeholder="Products required"><textarea name="message" placeholder="Tell us about quantities or deadlines"></textarea><button type="submit">Send enquiry →</button><p id="formStatus" style="grid-column:1/-1;margin:0;color:#e4bd68;font-size:12px"></p></form></div></section>

    <section class="section"><div class="section-inner faq-grid"><div><p class="eyebrow">Questions, answered</p><div class="section-heading"><h2>Make your next<br><span>move with clarity.</span></h2></div><p style="max-width:380px;color:var(--muted);font-size:13px;line-height:1.7">Need a recommendation before you buy? Our team is one message away.</p><a class="mini-link" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">Chat with a specialist →</a></div><div class="faq-list"><% [['Do you offer same-day delivery?','Yes. Same-day delivery is available for orders placed in the Colombo area before 2 PM. Outside Colombo, fast delivery is typically within 2–3 business days.'],['Are your products genuine and warranted?','All products are sourced from authorized manufacturers and carry manufacturer warranties where applicable.'],['Do you offer bulk discounts?','Yes. We support corporate orders, contractors, and project purchases with custom quotes and competitive bulk pricing.']].forEach((faq, index) => { %><div class="faq-item <%= index === 0 ? 'open' : '' %>"><button class="faq-question" type="button"><span><%= faq[0] %></span><b class="faq-icon"><%= index === 0 ? '−' : '+' %></b></button><div class="faq-answer"><%= faq[1] %></div></div><% }) %></div></div></section>

    <section class="contact-strip" id="contact"><div class="section-inner contact-grid"><div><p class="eyebrow">Visit, call, or write</p><div class="section-heading" style="margin-bottom:0"><h2>Let’s get to work.</h2></div><div class="contact-details"><div><strong>No.24 1/2, Messenger Street</strong><span>Colombo 12, Sri Lanka</span></div><div><strong><a href="tel:+94757505820">+94 75 750 5820</a></strong><span>Mon–Fri 8:30–5:30 · Sat 8:30–1</span></div><div><strong><a href="mailto:aman@fushidalanka.com">aman@fushidalanka.com</a></strong><span>Questions welcome</span></div></div></div><div class="contact-actions"><a class="btn btn-primary" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">WhatsApp us →</a><a class="btn btn-dark" href="tel:+94757505820">Call now</a></div></div></section>
  </main>

  <footer><div class="footer-inner"><div class="footer-grid"><div><a href="/" class="brand"><img class="brand-logo" src="/images/FushidaLankaLogo.png" alt="FushidaLanka Hardware"></a><p>One-stop destination for premium tools, building materials and hardware solutions. Quality products, expert service and unbeatable prices since 2010.</p></div><div><h4>Explore</h4><ul><li><a href="/products">Products</a></li><li><a href="#categories">Categories</a></li><li><a href="/about">About us</a></li><li><a href="#bulk-order">Trade supply</a></li></ul></div><div><h4>Categories</h4><ul><% categoryCards.forEach(category => { %><li><a href="/products?category=<%= category.slug || category.id %>"><%= category.name %></a></li><% }) %></ul></div><div><h4>Stay in the loop</h4><p>Get occasional product drops, offers and practical tips from the team.</p><form class="subscribe" onsubmit="event.preventDefault();this.querySelector('input').value='';alert('Thanks for subscribing!')"><input type="email" required placeholder="Your email address"><button>→</button></form></div></div><div class="footer-bottom"><span>© 2025 FushidaLanka Hardware. All rights reserved.</span><span>Quality tools. Better builds.</span></div></div></footer>
  <a class="whatsapp-float" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">◔ WhatsApp</a>

  <script>
    const nav = document.getElementById('siteNav');
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20), { passive: true });
    document.getElementById('menuToggle').addEventListener('click', () => document.getElementById('mobileNav').classList.toggle('open'));
    document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => document.getElementById('mobileNav').classList.remove('open')));
    const search = document.getElementById('productSearch');
    const cards = Array.from(document.querySelectorAll('.product-card'));
    const tabs = Array.from(document.querySelectorAll('#productTabs button'));
    let active = 'all';
    function filterProducts(){const term=(search.value||'').toLowerCase();cards.forEach(card=>{const hay=(card.dataset.search||'').toLowerCase();const cat=card.dataset.category||'';const visible=(!term||hay.includes(term))&&(active==='all'||cat===active);card.style.display=visible?'block':'none';});}
    search && search.addEventListener('input', filterProducts);
    tabs.forEach(tab => tab.addEventListener('click', () => {tabs.forEach(item=>item.classList.remove('active'));tab.classList.add('active');active=tab.dataset.filter;filterProducts();}));
    document.querySelectorAll('.quick-enquiry').forEach(button => button.addEventListener('click', () => {const message=encodeURIComponent(`Hi, I'm interested in ${button.dataset.name} - ${button.dataset.code}. Please provide availability and price.`);window.open(`https://wa.me/94757505820?text=${message}`,'_blank');}));
    document.querySelectorAll('.faq-question').forEach(question => question.addEventListener('click', () => {const item=question.parentElement;const icon=question.querySelector('.faq-icon');item.classList.toggle('open');icon.textContent=item.classList.contains('open')?'−':'+';}));
    document.getElementById('bulkForm').addEventListener('submit', async (event) => {event.preventDefault();const status=document.getElementById('formStatus');status.textContent='Sending enquiry…';try{const response=await fetch('/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(event.target)))});const result=await response.json();status.textContent=result.message||'Thanks — our team will get back to you shortly.';event.target.reset();}catch(error){status.textContent='Please call +94 75 750 5820 or message us on WhatsApp.';}});
  </script>
</body>
</html>
