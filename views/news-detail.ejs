<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"><style>.article{max-width:860px;margin:0 auto;padding:80px 20px}.article-meta{color:#9a7425;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.article h1{font-size:clamp(36px,6vw,68px);line-height:1.05;margin:14px 0 24px}.article-image{width:100%;max-height:480px;object-fit:cover;border-radius:14px;margin:28px 0}.article-body{color:#4f584f;font-size:17px;line-height:1.85;white-space:pre-line}</style></head><body><%- include('partials/header_new') %><main class="article"><span class="article-meta"><%= item.category || 'Company update' %></span><h1><%= item.title %></h1><p class="text-muted"><%= item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('en-LK') : '' %><% if (item.author) { %> · <%= item.author %><% } %></p><% if (item.featuredImage) { %><img class="article-image" src="<%= item.featuredImage %>" alt="<%= item.title %>"><% } %><div class="article-body"><%= item.content %></div><p style="margin-top:35px"><a href="/news">← Back to news</a></p></main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
