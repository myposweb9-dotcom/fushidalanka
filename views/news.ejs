<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><meta name="description" content="FushidaLanka updates, product news and practical hardware insights."><link rel="stylesheet" href="/css/style.css"><style>.public-page{max-width:1180px;margin:0 auto;padding:70px 20px}.public-hero{padding:70px 0;background:linear-gradient(135deg,#17251a,#315c38);color:#fff}.public-hero h1{color:#fff}.public-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;margin-top:35px}.public-card{overflow:hidden;background:#fff;border:1px solid #e5e5e5;border-radius:14px;box-shadow:0 8px 22px rgba(0,0,0,.07)}.public-card img{width:100%;height:180px;object-fit:cover;background:#eee}.public-card-body{padding:22px}.public-card h3{margin:0 0 8px}.public-card p{color:#667066;line-height:1.6}.public-meta{color:#9a7425;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.empty-state{padding:40px;border:1px dashed #cfcfcf;text-align:center;color:#677067}</style></head><body><%- include('partials/header_new') %><section class="public-hero"><div class="public-page"><p class="text-uppercase">FushidaLanka Hardware</p><h1>News & updates</h1><p>Product notes, company updates and useful guidance for your next build.</p></div></section><main class="public-page"><h2>Latest from FushidaLanka</h2><% if (news && news.length) { %><div class="public-grid"><% news.filter(item => item.published !== false).forEach(item => { %><article class="public-card"><img src="<%= item.featuredImage || '/images/fushida-detail.webp' %>" alt="<%= item.title %>" loading="lazy"><div class="public-card-body"><span class="public-meta"><%= item.category || 'Company update' %></span><h3><%= item.title %></h3><p><%= item.excerpt || (item.content || '').substring(0, 150) %></p><a href="/news/<%= item.slug || item.id %>">Read more →</a></div></article><% }) %></div><% } else { %><div class="empty-state">News and updates are coming soon. <a href="/contact">Subscribe through the team</a> to hear first.</div><% } %></main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
