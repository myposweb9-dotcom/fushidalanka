<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= product.name %> — FushidaLanka</title>
  <meta name="description" content="<%= product.description || 'High-quality hardware from FushidaLanka.' %>">
  <link rel="stylesheet" href="/css/subpages-redesign.css">
</head>
<body class="sp-page">
  <%- include('./partials/modern-header') %>
  <% const whatsappMessage = encodeURIComponent(`Hi, I'm interested in the ${product.name}. Can you provide more details?\nProduct: ${product.name}\nPrice: LKR ${product.price || 'Contact for pricing'}`); const whatsappUrl = `https://wa.me/94757505820?text=${whatsappMessage}`; %>
  <main>
    <section class="sp-hero sp-product-hero"><div class="modern-inner sp-hero-inner"><p class="sp-eyebrow"><%= product.category ? product.category.name : 'FushidaLanka hardware' %></p><h1><%= product.name %></h1><p><%= product.description || 'High-quality hardware for your next project.' %></p><div class="sp-actions" style="margin-top:26px"><a class="sp-button primary" href="/contact">Request a quote</a><a class="sp-button light" href="<%= whatsappUrl %>" target="_blank" rel="noreferrer">Chat on WhatsApp</a></div></div></section>
    <section class="sp-section"><div class="modern-inner sp-grid-2"><div><% if (product.images && product.images.length) { %><img class="sp-product-image" src="<%= product.images[0] %>" alt="<%= product.name %>"><% } else { %><img class="sp-product-image" src="/images/product-placeholder.svg" alt="<%= product.name %>"><% } %></div><div><p class="sp-eyebrow">Product details</p><h2>Ready for the <span>next job.</span></h2><p class="sp-lead"><%= product.description || 'Detailed product information coming soon.' %></p><div class="sp-price">LKR <%= product.price || 'Contact for pricing' %></div><div class="sp-meta"><div><strong>Category:</strong> <%= product.category ? product.category.name : 'Hardware' %></div><div><strong>Availability:</strong> <%= product.stock > 0 ? `In stock (${product.stock} available)` : 'Contact for availability' %></div><% if (product.specifications) { Object.entries(product.specifications).slice(0,5).forEach(([key,value]) => { %><div><strong><%= key %>:</strong> <%= value %></div><% }) } %></div><div class="sp-actions"><a class="sp-button primary" href="/contact">Request quote →</a><a class="sp-button" href="<%= whatsappUrl %>" target="_blank" rel="noreferrer">WhatsApp →</a><% if (product.datasheet) { %><a class="sp-button" href="<%= product.datasheet %>" download>Datasheet ↓</a><% } %></div></div></div></section>
    <section class="sp-section alt"><div class="modern-inner"><p class="sp-eyebrow">Need more information?</p><h2>Talk to our <span>team.</span></h2><p class="sp-lead">We can help with specifications, quantities, delivery and project pricing.</p><a class="modern-cta" href="/contact">Contact us →</a></div></section>
  </main>
  <%- include('./partials/modern-footer') %>
  <a class="sp-whatsapp" href="<%= whatsappUrl %>" target="_blank" rel="noreferrer">◔ WhatsApp</a>
</body>
</html>
