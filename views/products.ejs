<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Products - FushidaLanka' %></title>
  <meta name="description" content="Browse premium tools, building materials, electrical supplies and safety equipment from FushidaLanka.">
  <link rel="stylesheet" href="/css/home-redesign.css">
  <link rel="stylesheet" href="/css/subpages-redesign.css">
</head>
<body class="home-redesign sp-page">
  <%- include('partials/modern-header') %>
  <main>
    <section class="sp-hero catalog-hero"><div class="modern-inner sp-hero-inner"><p class="sp-eyebrow">Curated for the job</p><h1>Find the right<br><span>gear.</span></h1><p>Explore dependable tools, building materials and hardware solutions for every kind of build.</p></div></section>
    <section class="sp-section" id="products-section"><div class="modern-inner"><div class="section-heading"><div><p class="sp-eyebrow">Our catalogue</p><h2>Products, <span>sorted.</span></h2></div><p class="sp-lead" style="max-width:390px">Search by product, category or specification. Need something specific? Our team can help you find it.</p></div><div class="catalog-tools"><label class="catalog-search">⌕ <input id="productSearch" type="search" placeholder="Search product name, code, brand or specification"></label><div class="catalog-tabs" id="productTabs"><button class="active" data-filter="all" type="button">All products</button><% (categories || []).forEach(category => { %><button data-filter="<%= category.id %>" type="button"><%= category.name %></button><% }) %></div></div><div class="catalog-grid" id="productGrid"><% if (products && products.length) { products.forEach(product => { %><article class="catalog-card" data-category="<%= product.categoryId || '' %>" data-search="<%= [product.name,product.code,product.brand,product.description,product.category && product.category.name].filter(Boolean).join(' ') %>"><div class="catalog-card-image"><% if (product.images && product.images.length) { %><img src="<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy"><% } else { %><img src="/images/product-placeholder.svg" alt="<%= product.name %>" loading="lazy"><% } %><span class="catalog-card-badge"><%= product.status === 'active' ? 'Available' : 'New' %></span></div><div class="catalog-card-body"><span class="catalog-card-category"><%= product.category ? product.category.name : 'Hardware' %></span><h3><%= product.name %></h3><p><%= product.description ? product.description.substring(0,100) : 'Premium quality product for your next project.' %></p><div class="catalog-card-footer"><span class="catalog-price"><%= product.price ? 'LKR '+parseInt(product.price).toLocaleString('en-LK') : 'Contact us' %></span><a class="catalog-view" href="/products/<%= product.id %>">View details ↗</a></div></div></article><% }) } else { %><div class="sp-card" style="grid-column:1/-1;text-align:center"><h3>The catalogue is being refreshed.</h3><p>Contact our team for help sourcing what you need.</p><a class="modern-cta" href="/contact">Get help →</a></div><% } %></div></div></section>
    <section class="sp-section alt"><div class="modern-inner sp-grid-2"><div><p class="sp-eyebrow">Need a recommendation?</p><h2>Talk to the <span>team.</span></h2></div><div><p class="sp-lead">Tell us what you’re building and we’ll help you choose the right products, quantities and delivery plan.</p><a class="modern-cta" href="/bulk-order">Request a bulk quote →</a></div></div></section>
  </main>
  <%- include('partials/modern-footer') %>
  <a class="sp-whatsapp" href="https://wa.me/94757505820" target="_blank" rel="noreferrer">◔ WhatsApp</a>
  <script>
  const search=document.getElementById('productSearch'),cards=[...document.querySelectorAll('.catalog-card')],tabs=[...document.querySelectorAll('#productTabs button')];let active='all';function applyFilters(){const term=(search.value||'').toLowerCase();cards.forEach(card=>{const matchesText=!term||(card.dataset.search||'').toLowerCase().includes(term);const matchesCategory=active==='all'||card.dataset.category===active;card.style.display=matchesText&&matchesCategory?'flex':'none'})}search.addEventListener('input',applyFilters);tabs.forEach(tab=>tab.addEventListener('click',()=>{tabs.forEach(item=>item.classList.remove('active'));tab.classList.add('active');active=tab.dataset.filter;applyFilters()}));
  </script>
</body>
</html>
